{#=====================================================
  Base template
  - Used as the basis of all pages
=====================================================#}

<!DOCTYPE html>

<html lang="en" data-theme="light">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>Notes Demo {% block title %}{% endblock %}</title>

    <link rel="icon" href="/static/images/note.svg">

    <script src="/static/js/utils.js"></script>

    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/messages.css">
    <link rel="stylesheet" href="/static/css/styles.css">
</head>

<body>

    <header>


        <nav>

            <span class="greeting">
                {% if session.logged_in %}
                Welcome, <strong>{{ session.user.username }}</strong>!
                {% else %}
                Welcome, guest!
                {% endif %}
            </span>

            {% if session.logged_in %}
                <a href="/">Home</a>
                <a href="/job/new">Post a job</a>
                <a href="/find_job">Find Jobs</a>
                <a href="/logout">Logout</a>
            {% else %}
                <a href="/">Home</a>
                <a href="/user/new">Sign Up</a>
                <a href="/login">Login</a>
            {% endif %}
        </nav>
        
    </header>


    {# Show flash messages from any previous events #}
    {% include "partials/messages.jinja" %}


    

    <main>

        {% block content %}
        {% endblock %}

    </main>

</body>

</html>

