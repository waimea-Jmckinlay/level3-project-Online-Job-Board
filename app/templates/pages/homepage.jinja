{#=====================================================
  Home page
=====================================================#}
{% extends 'pages/_base.jinja' %}

{% block content %}

    {% if session.logged_in %}
      <h2>Jobs you posted</h2>
    {% else %}
      <h2>All Jobs</h2>
    {% endif %}

    <section id="jobs-list">

      {% for job in jobs %}
       {% if not offers.done %}  {# Only show if it is NOT finished #}
          <div class="jobs-item">
            <header>
              <h3>{{ job.title }}</h3>
              <p>{{ job.notes }}</p>
              <p>{{ job.address }}</p>
              <p>{{ job.due_by_date }}</p>
            </header>

            <footer>
              {% if session.logged_in %}

                <a
                class="button"
                title="Edit job"
                href= "/job/{{job.id}}/edit">Edit</a>

                <a
                class="button"
                title="Delete job"
                onclick="return confirm('Really delete?')"
                href="/job/{{job.id}}/delete"
                              >delete</a>

                <a
                class="button"
                title="job info"
                href= "/job/{{job.id}}/job_offers">info</a>

              {% endif %} 
            </footer>
          </div>

        {% endif %}  
       {% endfor %} 


      {% if session.logged_in  %}

        <h3>My Offers</h3>

          {% if offers | length > 0 %}

            {% for offer in offers %}

                <div class ="job-offer">
                  <header>
                    <p> title: {{offer.title}}</p>
                    <p> Notes: {{offer.notes}}</p>
                    <p> Accepted: {{offer.accepted}}</p>
                    <p> Done: {{offer.job_done}}</p>
                  </header>
                </div>
            {% endfor %}

          {% else %}
            <p>None</p>
          {% endif %}
      {% endif %}

      
    </section>

{% endblock %}
