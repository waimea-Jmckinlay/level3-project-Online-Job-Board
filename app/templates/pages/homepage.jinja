{#=====================================================
  Home page
=====================================================#}
{% extends 'pages/_base.jinja' %}

{% block content %}

    {% if session.logged_in %}
      <h2>Jobs you posted</h2>
    {% else %}
      <h2>All Jobs</h2>
    {% endif %}

    <section id="jobs-list">

      {% for job in jobs %}
          <div class="jobs-item">
            <header>
                <h3>{{ job.title }}</h3>
            </header>

            <p>{{ job.notes }}</p>
            <p>{{ job.address }}</p>
            <p>{{ job.due_by_date }}</p>
          </div>

          {% if session.logged_in %}

            <a
            class="button"
            title="Edit message"
            href= "/job/{{job.id}}/edit">Edit</a>

            <a
            class="button"
            title="Delete job"
            onclick="return confirm('Really delete?')"
            href="/job/{{job.id}}/delete"
                          >delete</a>
  
          {% endif %}


       {% endfor %} 

      {% if session.logged_in %}

        <h3>My Offers</h3>

            {% for offer in offers %}
              {% if offer.user_id == session.user.id %}
                <div>
                  <p>Job: {{jobs[offer.job_id].title}}</p>
                  <p>Notes: {{jobs[offer.job_id].notes}}</p>
                  <p>Accepted: {{offer.accepted}}</p>
                  <p>Done: {{offer.job_done}}</p>
                </div>
              {% endif%}
            {% endfor %}

      {% endif %}

      
    </section>

{% endblock %}
