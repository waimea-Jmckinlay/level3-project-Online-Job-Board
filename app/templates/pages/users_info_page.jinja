{% extends 'pages/_base.jinja' %}

{% block content %}


    <section id="jobs-list">

          <div class="jobs-item">
            <header>
                <h3>{{ users.username }}</h3>
            </header>

            <p>{{ users.real_name }}</p>
            <p>{{ users.contact_info }}</p>
            <p>{{ users.rating }}</p>
          </div>


          {% endfor %}
          {% else %}
          <P>None</P>
        {%endif%}  

{% endblock %}          
