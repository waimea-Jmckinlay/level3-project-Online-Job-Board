{#=====================================================
Job page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block content %}



          <div class="jobs-item">
            <header>
                <h3>{{ user.real_name }}</h3>
            </header>
            
            <p>{{ user.username }}</p>
            <p>{{ user.contact_info }}</p>
              <ul>
              {% if ratings | length > 0 %}
              {%for rating in ratings %}
              <p> {{ rating }} </p>
              {%endfor%}
              {% else %}
              <P>None</P>
              {%endif%}
            </ul>
          </div>

  <a
   class="button"
   title=" back to job"
   href= "/job/{{ job_id }}/job_offers">back to job
  </a>



{% endblock %}          
