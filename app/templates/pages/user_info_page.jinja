{#=====================================================
Job page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block content %}



          <div class="user-item">
            <header>
                <h3>{{ user.real_name }}</h3>
            </header>
            
            <p>{{ user.username }}</p>
            <p>{{ user.contact_info }}</p>
              
              {% if ratings | length > 0 %}
                <ul>
                  {%for rating in ratings %}
                  <p> {{ rating }} </p>
                  {%endfor%}
                </ul>
              {% else %}
              <p>None</p>
              {%endif%}
            
          </div>

  <a
   class="button"
   title=" back to job"
   href= "/job/{{ job_id }}/job_offers">Back to job
  </a>



{% endblock %}          
