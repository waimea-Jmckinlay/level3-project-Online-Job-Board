{#=====================================================
Job page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block content %}


    <section id="jobs-list">

          <div class="jobs-item">
            <header>
                <h3>{{ job.title }}</h3>
            </header>

            <p>{{ job.notes }}</p>
            <p>{{ job.address }}</p>
            <p>{{ job.due_by_date }}</p>
          </div>
          
        {% if offers | length > 0 %}
          {% for offer in offers %}

            <div class="offer">
              <p>{{offer.real_name}} ({{offer.username}})</p>

              <a
              class="button"
              title="job info"
              href= "/job/{{ offer.job_id }}/job_offers/user_show/{{ offer.user_id }}">info</a>

            </div>

          {% endfor %}
          {% else %}
          <P>None</P>
        {%endif%}  

{% endblock %}          
