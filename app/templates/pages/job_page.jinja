{#=====================================================
Job page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block content %}


    <section id="jobs-list">

          <div class="jobs-item">
            <header>
                <h3>{{ job.title }}</h3>
            </header>

            <p>{{ job.notes }}</p>
            <p>{{ job.address }}</p>
            <p>{{ job.due_by_date }}</p>

             <a
            class="button"
            title="Edit job"
            href= "/job/{{job.id}}/edit">Edit</a>

            <a
            class="button"
            title="Delete job"
            onclick="return confirm('Really delete?')"
            href="/job/{{job.id}}/delete"
                          >Delete</a>




          </div>
          <H3> Offers</H3>
        {% if offers | length > 0 %}
          {% for offer in offers %}

            <div class="job-offer">
              <p>{{offer.real_name}} ({{offer.username}})</p>

              {% if offer.accepted %}
                ACCEPTED
              {% endif %}

                {% if offer.accepted %}

              <a
              class="button"
              title="job done"
              href= "/job/{{ offer.job_id }}/offer/{{ offer.offer_id }}/complete"
              >finsh job
              </a>
              {% endif %}


               {% if offer.accepted == false %}
              <a
              class="button"
              title="accpete user"
              href= "/job/{{offer.job_id}}/offers/{{ offer.offer_id }}/accept">Accept offer</a>
              {% endif %}


              <a
              class="button"
              title="job info"
              href= "/job/{{ offer.job_id }}/offers/user/{{ offer.user_id }}">See user info</a>

              
              <a
              class="button"
              title="remove user offer"
              href= "/job/{{offer.job_id}}/offers/{{ offer.offer_id }}/delete">Reject offer</a>

            </div>

          {% endfor %}
          {% else %}
          <P>None</P>
        {%endif%}  

{% endblock %}          
