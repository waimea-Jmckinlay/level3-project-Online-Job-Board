search page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>jobs</h2>

    <section id="jobs">

        {% for job in jobs %}

            <div class="offers-accapted">
                <header>
                    <h3>{{ job.title }}</h3>
                    <p class="jobs-notes">{{ job.notes }}</p>
                    <p class="author">Posted by <strong>{{ job.username }}</strong> ({{ job.username }})</p>
                </header>

                <footer>
                    {% if session.logged_in %}
                        <p><a class="button" href="/job/{{ job.id }}/accept">apply</a></p>
                    {% endif %}
                </footer>
            </div>

        {% else %}

            <p>No jobs!</p>

        {% endfor %}

    </section>

{% endblock %}
